{
  "name": "y-stage3",
  "version": "6.0.5",
  "description": "Y.Stage 4比赛系统",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:kernel && npm run build:web && npm run build:server",
    "build:kernel": "esbuild server/cordis/create-root.cjs --bundle --platform=node --format=cjs --outfile=server/cordis/kernel.cjs",
    "build:web": "esbuild web/kernel.mjs --bundle --format=esm --outfile=web/dist/kernel.js",
    "build:server": "esbuild server.js --bundle --platform=node --format=cjs --sourcemap=external --outfile=dist-server/server.bundle.cjs",
    "portable": "node scripts/make-portable.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cordis": "4.0.0-rc.9",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "nodemon": "^2.0.7"
  }
}
